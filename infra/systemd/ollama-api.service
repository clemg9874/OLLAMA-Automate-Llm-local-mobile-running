[Unit]
Description=OLLAMA Automate API
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Projets/OLLAMA-Automate-Llm-local-mobile-running
ExecStart=/usr/bin/pnpm --filter @apps/api dev
Restart=always
RestartSec=3
Environment=HOST=0.0.0.0
Environment=PORT=3000

[Install]
WantedBy=default.target
